{
  "identifier": "default",
  "description": "Capability for the main window — grants all permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:1420/*", "http://localhost:1420/*"]
  }
}
